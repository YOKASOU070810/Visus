@rem Gradle wrapper startup script for Windows
@if "%DEBUG%" == "" @echo off
@rem Set local scope for the variables with windows NT shell
if "%OS%"=="Windows_NT" setlocal

set DIRNAME=%~dp0
if "%DIRNAME%" == "" set DIRNAME=.

@rem This is normally auto-generated; Android Studio will create the full wrapper.
@rem If you see this, open the project in Android Studio and it will set up Gradle.
echo Gradle wrapper not yet initialized. Please open this project in Android Studio first.
echo Android Studio will automatically download and set up the Gradle wrapper.
exit /b 1
