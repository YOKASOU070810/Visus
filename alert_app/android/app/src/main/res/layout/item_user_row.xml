<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:background="#fff" android:padding="12dp"
    android:gravity="center_vertical" android:layout_marginBottom="1dp" android:elevation="1dp">

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/userName" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="15sp" android:textStyle="bold"
            android:textColor="#333"/>
        <TextView android:id="@+id/userEmail" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#888"/>
    </LinearLayout>

    <Button android:id="@+id/actionBtn" android:layout_width="wrap_content"
        android:layout_height="38dp" android:textSize="13sp" android:textStyle="bold"
        android:textColor="#fff" android:paddingStart="14dp" android:paddingEnd="14dp"
        android:backgroundTint="#1a73e8"/>
</LinearLayout>
