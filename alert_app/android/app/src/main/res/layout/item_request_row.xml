<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:background="#fff" android:padding="14dp"
    android:gravity="center_vertical" android:layout_marginBottom="8dp" android:elevation="1dp">

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/requestName" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="16sp" android:textStyle="bold"
            android:textColor="#333"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="wants to be your friend" android:textSize="13sp" android:textColor="#888"/>
    </LinearLayout>

    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button android:id="@+id/approveBtn" android:layout_width="wrap_content"
            android:layout_height="38dp" android:text="Approve" android:textSize="12sp"
            android:textStyle="bold" android:textColor="#fff" android:backgroundTint="#34a853"
            android:layout_marginEnd="6dp"/>
        <Button android:id="@+id/declineBtn" android:layout_width="wrap_content"
            android:layout_height="38dp" android:text="Decline" android:textSize="12sp"
            android:textStyle="bold" android:textColor="#fff" android:backgroundTint="#e63946"/>
    </LinearLayout>
</LinearLayout>
