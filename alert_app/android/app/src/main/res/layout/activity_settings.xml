<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#f0f2f5">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Server Configuration"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#1a73e8"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enter the AlertBuddy server address on your local network:"
        android:textSize="14sp"
        android:textColor="#666"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/serverUrlInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="http://192.168.1.100:8000"
        android:inputType="textUri"
        android:padding="14dp"
        android:background="@android:drawable/edit_text"
        android:textSize="16sp"
        android:layout_marginBottom="20dp" />

    <Button
        android:id="@+id/saveButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Save and Connect"
        android:textColor="#fff"
        android:backgroundTint="#1a73e8"
        android:textSize="16sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Tip: Make sure your phone and the server are on the same WiFi network."
        android:textSize="13sp"
        android:textColor="#999" />

</LinearLayout>
