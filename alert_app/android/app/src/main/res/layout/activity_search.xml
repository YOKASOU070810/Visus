<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#f0f2f5">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="#1a73e8" android:padding="12dp" android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView android:id="@+id/backBtn" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="Back" android:textColor="#fff"
            android:textSize="15sp" android:paddingEnd="12dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Search Users" android:textColor="#fff" android:textSize="18sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="12dp" android:background="#fff">
        <EditText android:id="@+id/searchInput" android:layout_width="0dp"
            android:layout_height="46dp" android:layout_weight="1" android:hint="Search by email or name"
            android:inputType="text" android:padding="10dp" android:textSize="15sp"
            android:background="@android:drawable/edit_text"/>
        <Button android:id="@+id/searchBtn" android:layout_width="wrap_content"
            android:layout_height="46dp" android:text="Search" android:textColor="#fff"
            android:backgroundTint="#1a73e8"/>
    </LinearLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ListView android:id="@+id/userList" android:layout_width="match_parent"
            android:layout_height="match_parent" android:divider="@null" android:dividerHeight="1dp"
            android:padding="8dp"/>
        <TextView android:id="@+id/emptyText" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_gravity="center"
            android:text="Search for users to add friends" android:textColor="#999"
            android:textSize="15sp"/>
        <ProgressBar android:id="@+id/progress" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_gravity="center" android:visibility="gone"/>
    </FrameLayout>
</LinearLayout>
