<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#f0f2f5">

    <!-- Search bar -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="8dp" android:background="#fff">
        <EditText android:id="@+id/searchInput" android:layout_width="0dp"
            android:layout_height="46dp" android:layout_weight="1"
            android:hint="Search by name or email" android:inputType="text"
            android:padding="10dp" android:textSize="15sp"
            android:background="@android:drawable/edit_text"/>
        <Button android:id="@+id/searchBtn" android:layout_width="wrap_content"
            android:layout_height="46dp" android:text="Search" android:textColor="#fff"
            android:backgroundTint="#1a73e8" android:layout_marginStart="6dp"/>
    </LinearLayout>

    <!-- Results -->
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ListView android:id="@+id/searchResultsList" android:layout_width="match_parent"
            android:layout_height="match_parent" android:divider="@null"
            android:dividerHeight="1dp" android:padding="6dp"/>
        <TextView android:id="@+id/emptySearch" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_gravity="center"
            android:text="Search for users to add friends" android:textColor="#999"
            android:textSize="14sp"/>
        <ProgressBar android:id="@+id/progressSearch" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_gravity="center" android:visibility="gone"/>
    </FrameLayout>
</LinearLayout>
