<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#f0f2f5">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="#1a73e8" android:padding="12dp" android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView android:id="@+id/backBtn" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="Back" android:textColor="#fff"
            android:textSize="15sp" android:paddingEnd="12dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Friend Requests" android:textColor="#fff" android:textSize="18sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ListView android:id="@+id/requestsList" android:layout_width="match_parent"
            android:layout_height="match_parent" android:divider="@null" android:dividerHeight="8dp"
            android:padding="8dp"/>
        <TextView android:id="@+id/emptyText" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_gravity="center"
            android:text="No pending friend requests" android:textColor="#999" android:textSize="15sp"/>
        <ProgressBar android:id="@+id/progress" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_gravity="center" android:visibility="gone"/>
    </FrameLayout>
</LinearLayout>
