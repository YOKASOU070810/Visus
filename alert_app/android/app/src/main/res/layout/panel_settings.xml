<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#f0f2f5" android:padding="16dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Settings" android:textColor="#333" android:textSize="20sp"
        android:textStyle="bold" android:layout_marginBottom="20dp"/>

    <!-- Server config -->
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Server Address" android:textColor="#666" android:textSize="13sp"
        android:layout_marginBottom="6dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="#fff" android:padding="8dp" android:elevation="1dp"
        android:layout_marginBottom="16dp">
        <EditText android:id="@+id/settingsServerUrl" android:layout_width="0dp"
            android:layout_height="48dp" android:layout_weight="1"
            android:textSize="14sp" android:padding="10dp"
            android:background="@android:drawable/edit_text"/>
        <Button android:id="@+id/settingsSaveBtn" android:layout_width="wrap_content"
            android:layout_height="48dp" android:text="Save" android:textColor="#fff"
            android:backgroundTint="#1a73e8" android:layout_marginStart="6dp"/>
    </LinearLayout>
    <TextView android:id="@+id/settingsMsg" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#34a853"
        android:layout_marginBottom="20dp" android:visibility="gone"/>

    <!-- Logout -->
    <Button android:id="@+id/settingsLogoutBtn" android:layout_width="match_parent"
        android:layout_height="50dp" android:text="Logout" android:textColor="#fff"
        android:backgroundTint="#e63946" android:textSize="16sp" android:textStyle="bold"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:text="AlertBuddy v0.1.0" android:textColor="#bbb"
        android:textSize="12sp" android:layout_gravity="center"/>

</LinearLayout>
