<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#f0f2f5">

    <!-- Top bar -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="50dp"
        android:background="#1a73e8" android:paddingStart="14dp" android:paddingEnd="8dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="AlertBuddy" android:textColor="#fff"
            android:textSize="18sp" android:textStyle="bold"/>
    </LinearLayout>

    <!-- Content panels -->
    <FrameLayout android:id="@+id/contentPanel" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1">
        <include android:id="@+id/panelFriends" layout="@layout/panel_friends"
            android:visibility="visible"/>
        <include android:id="@+id/panelSearch" layout="@layout/panel_search"
            android:visibility="gone"/>
        <include android:id="@+id/panelRequests" layout="@layout/panel_requests"
            android:visibility="gone"/>
        <include android:id="@+id/panelSettings" layout="@layout/panel_settings"
            android:visibility="gone"/>
    </FrameLayout>

    <!-- Bottom nav -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
        android:orientation="horizontal" android:background="#fff"
        android:elevation="8dp" android:gravity="center">
        <Button android:id="@+id/tabFriends" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1"
            android:text="Friends" android:textColor="#1a73e8" android:textStyle="bold"
            android:textSize="14sp" android:backgroundTint="#fff"
            android:insetTop="0dp" android:insetBottom="0dp"/>
        <Button android:id="@+id/tabSearch" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1"
            android:text="Search" android:textColor="#999" android:textStyle="bold"
            android:textSize="14sp" android:backgroundTint="#fff"
            android:insetTop="0dp" android:insetBottom="0dp"/>
        <Button android:id="@+id/tabRequests" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1"
            android:text="Requests" android:textColor="#999" android:textStyle="bold"
            android:textSize="14sp" android:backgroundTint="#fff"
            android:insetTop="0dp" android:insetBottom="0dp"/>
        <Button android:id="@+id/tabSettings" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1"
            android:text="Settings" android:textColor="#999" android:textStyle="bold"
            android:textSize="14sp" android:backgroundTint="#fff"
            android:insetTop="0dp" android:insetBottom="0dp"/>
    </LinearLayout>
</LinearLayout>
